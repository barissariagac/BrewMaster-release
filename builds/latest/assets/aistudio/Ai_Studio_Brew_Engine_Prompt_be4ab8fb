### 1. FONKSİYON İMZASI (GİRDİLER VE ÇIKTILAR)

```typescript
export interface RecommendationInput {
  originId: string;                 // origins.json -> CoffeeOrigin.id (Çekirdeğin yöresi/lotu)
  processId: ProcessMethodId;       // constants.ts -> 12 işleme yönteminden biri
  roastId: RoastLevelId;            // 'light' | 'light_medium' | 'medium' | 'medium_dark' | 'dark'
  // Opsiyonel ince ayarlar (boş bırakılırsa otomatik varsayılanlar devreye girer):
  exactAgtronGround?: number;       // 35–88 arası kesin Agtron Ground değeri (girilmezse bandın orta noktası)
  exactAgtronWhole?: number;        // Opsiyonel Whole Bean Agtron (Delta gelişim kontrolü için)
  grinderId?: string;               // Varsayılan: 'eureka_mignon_filtro' (veya GRINDER_SPECS[0])
  doseGrams?: number;               // Varsayılan: seçilen reçetenin baseCoffeeGrams değeri
  daysPostRoast?: number;           // Varsayılan: 10 (Blooming süresi kalibrasyonu için)
  allowedCategories?: EquipmentCategory[]; // Opsiyonel kategori filtresi (örn. sadece pour-over)
}

export interface BrewRecommendationResult {
  // 1. Ana Öneri (En yüksek Ekipman × Reçete korelasyon skoru)
  recommendedEquipment: BrewingEquipment;
  recommendedRecipe: BrewRecipe;
  correlationScore: number;         // 50 – 99 (%)
  rationaleSummary: string;         // Türkçe, kullanıcıya anlaşılır 2 cümlelik bilimsel gerekçe

  // 2. Alternatif İlk 3 (Ekipman × Reçete) Çifti
  topAlternatives: Array<{
    equipment: BrewingEquipment;
    recipe: BrewRecipe;
    score: number;
  }>;

  // 3. Hesaplanan Öğütüm Kalınlığı ve Değirmen Ayarı
  grind: {
    effectiveZone: string;          // recipe.referenceZoneOverride ?? equipment.referenceZone
    baseMicron: number;
    finalMicron: number;            // Tüm düzeltmeler sonrası nihai mikron (µm)
    micronBreakdown: {
      solubilityDelta: number;      // (S_bean - 0.5) * 110
      varietalDelta: number;        // Etiyopya Heirloom +25µm, Pacamara -15µm
      doseDelta: number;            // (dose - 18) * 6µm
      burrDelta: number;            // Flat burr (Eureka/Ode/EK43): -20µm, Conical: 0µm
    };
    grinderName: string;
    grinderSettingLabel: string;    // Örn: "2.9 Kadran (1. Tur)" veya "22 Klik"
    visualReference: string;        // Örn: "İnce Deniz Tuzu / Toz Şeker"
  };

  // 4. Kalibre Edilmiş Reçete Parametreleri (Ölçeklenmiş adımlarla)
  calibratedRecipe: {
    coffeeGrams: number;
    totalWaterGrams: number;
    ratioLabel: string;             // Örn: "1:16.8"
    waterTempC: number;             // 85.0 – 97.0 °C (veya Türk Kahvesi/Cold Brew istisnası)
    bloomDurationSec: number;       // Tazeliğe göre 30 / 35 / 45 sn
    agitationLevel: 'high' | 'balanced' | 'low';
    scaledSteps: BrewRecipeStep[];  // doseGrams ve totalWaterGrams'a göre orantısal güncellenmiş adımlar
  };

  // 5. Bilimsel & UC Davis RSM Analiz Çıktıları
  scienceMeta: {
    agtronUsed: number;
    roastSolubilityR: number;       // 0.0 – 1.0
    processSolubilityP: number;     // 0.15 – 1.0
    altitudeDensityD: number;       // 0.10 – 1.0
    compositeSolubilityS: number;   // 0.45R + 0.35P + 0.20(1-D)
    targetSensoryVector: { acidity: number; sweetness: number; body: number; clarity: number };
    rsmTargetZone: {
      targetPE: string;             // Örn: "%20.0 – %21.2"
      targetTDS: string;            // Örn: "%1.18 – %1.26"
      quadrantNote: string;         // UC Davis RSM yönelimi (Örn: "Sol-Alt Doğal Tatlılık Odaklı")
    };
  };
}
```

